# rust-dos configuration file
#
# rust-dos uses the first configuration file it finds (files are never
# merged):
#   1. the file given with -c/--config
#   2. rust-dos.conf in the current working directory
#   3. rust-dos.conf in the per-user configuration directory:
#        Linux:   ~/.config/rust-dos/  (or $XDG_CONFIG_HOME/rust-dos/)
#        macOS:   ~/Library/Application Support/rust-dos/
#        Windows: %APPDATA%\rust-dos\
# If none exists, a copy of this template is written to (3).
# Start with --no-config to ignore all configuration files.
#
# Lines starting with # or ; are comments. Remove the # to use a setting.

[emulator]
# Window scale factor. -s/--scale overrides it.
#scale=2
# Fill the screen instead of a window, keeping the picture's proportions.
#fullscreen=false
# Display ratio: none (native pixels), 4:3, 5:4, 16:10 or 16:9.
#aspect=none
# For a variable refresh rate (G-Sync, FreeSync) display: show each frame
# when the machine draws it, at its own rate (70 Hz for VGA) rather than
# a steady 60 Hz. VRR must be on in the graphics driver or desktop too.
#vrr=false
# How the picture is scaled up: nearest (sharp pixels) or linear (smooth).
# Only without a CRT shader, which does its own scaling.
#filter=nearest
# A CRT look for the picture:
#   none       the pixels as they are (the default)
#   scanlines  a flat screen with the scanlines of a VGA monitor
#   aperture   a flat aperture grille monitor: scanlines and phosphor stripes
#   crt        a curved tube with a shadow mask, rounded corners and glow
# The looks need OpenGL 3 and show best at scale 2 or more, or fullscreen.
# Screenshots and recordings stay without them.
#shader=none
# How far the crt look's tube bends, in percent: 0 is flat, 100 the most.
#crt_curvature=30
# How much light glows around the bright parts of the crt look, in
# percent: 0 is none, 100 the most.
#crt_glow=20
# A monochrome monitor: off (colour, the default), white, amber or green.
# The picture shows in the phosphor's colour, as bright as its colours
# are, and the CRT shaders leave out their colour mask. On a VGA or EGA
# (machine), programs see the monochrome monitor too, from the DOS prompt
# on, and the prompt is the monochrome text mode 7.
#monochrome=off
# The CGA's composite monitor (machine=cga): the colours a composite
# monitor or TV makes of fine patterns of pixels, which King's Quest, the
# Ultima games and many more drew their graphics with. auto (the default)
# decodes the picture as a composite monitor does when a program turns on
# 640x200 graphics with the colour burst, which only programs for
# composite monitors do; on always does in the graphics modes; off shows
# the RGB monitor's colours.
#composite=auto
# The CGA that makes the composite signal: old (IBM's first cards, which
# the classic games were drawn for) or new (from 1984 on).
#composite_era=old
# CPU speed in instructions per millisecond; max to run as fast as the
# host keeps up with in real time; or auto (the default), which gives a
# game as much speed as makes its frames come faster, up to the
# display's refresh rate, and runs programs with no frames to go by at
# 3000 in real mode and at max in protected mode. "auto 10000" makes
# 10000 the least it runs at. Lower it for old games that run too fast.
# --cycles overrides it.
#cycles=auto
# Processor: 486 (the default, a 486DX with FPU), 386, pentium (with
# CPUID, the time stamp counter, MSRs, CMPXCHG8B and 4 MB pages), or
# pentium_mmx (that Pentium with MMX).
#cpu=486
# What runs the programs' instructions:
#   auto     the interpreter, and the dynamic recompiler for a program
#            from when it switches to protected mode until it ends (the
#            default, as in DOSBox)
#   dynamic  the dynamic recompiler, which translates the programs' code
#            into the host's and runs protected-mode games several times
#            faster
#   normal   the interpreter
# Both run programs exactly the same way. The recompiler needs an x86-64
# or ARM64 host; on others the interpreter runs everything. --core
# overrides it.
#core=auto
# How the FPU adds and subtracts:
#   exact  on 80 bits, as a real 387 does (the default)
#   fast   on the host's 64-bit doubles: less host CPU in FPU-heavy games
#          such as Quake, but results can differ in the last bits
#fpu=exact
# The display adapter, which programs look for to pick their graphics:
#   svga  a VGA with VESA modes up to 1024x768 (the default)
#   svga_s3  an S3 Trio64 on the PCI bus, for booted systems' drivers
#   svga_s3virge, svga_s3virgevx  an S3 ViRGE or ViRGE/VX on the PCI bus,
#         with its 3D engine, for Direct3D in a booted Windows 95
#   svga_verite  a Rendition Vérité V1000, for DOS games' Vérité versions
#   svga_et4000  a Tseng ET4000AX with 1 MB and a Sierra HiColor DAC:
#         Tseng's modes, 32K and 64K colours, VBE 1.2 without a linear
#         frame buffer
#   vga   an IBM VGA, without VESA modes
#   ega   an IBM EGA with an Enhanced Color Display: 16 of 64 colours
#   cga   an IBM CGA: 4 colours at 320x200, 2 at 640x200
#   tandy a Tandy 1000: the CGA's modes and 16 colours at 160x200 and
#         320x200, 4 at 640x200, and its three-voice sound chip
#   pcjr  an IBM PCjr, which the Tandy copies
#   hercules  a Hercules Graphics Card on a monochrome monitor: text and
#         720x348 graphics
# A change takes effect at the DOS prompt.
#machine=svga
# A 3dfx Voodoo Graphics for games that draw with Glide, in DOS or in a
# booted Windows 95, with 12 MB (4 MB frame buffer, two texture units) or
# 4 MB (2 MB, one texture unit). Changes take effect at the DOS prompt.
#voodoo=false
#voodoo_memory=12
# What draws the card's picture in the window: software (rust-dos) or
# opengl, which draws it again at voodoo_scale (1 to 4) times the card's
# resolution. Screenshots show the software picture either way.
#voodoo_renderer=software
# Texture sampling for both renderers: default (as the game sets it) or
# unfiltered (nearest-neighbour). With OpenGL anisotropy enabled, unfiltered
# also blends mip levels and allows anisotropic filtering to reduce shimmer;
# magnification stays nearest-neighbour. Software stays strictly unfiltered.
# Changes take effect immediately.
#voodoo_texture_sampling=default
#voodoo_scale=2
# Whether the CRT look sizes its scanlines for voodoo_scale: true or false.
# Only the CRT look uses it, and only above 1x.
#voodoo_scale_shader=true
# Texture anisotropy for the OpenGL Voodoo renderer: off, 2, 4, 8 or 16.
#voodoo_anisotropy=off
# The gamma Glide applies to the 3dfx picture, as the environment variables
# SST_RGAMMA, SST_GGAMMA and SST_BGAMMA: off, or a factor from 0.1 to 2. A
# variable the guest sets itself wins.
#voodoo_gamma=off
# A PowerVR PCX2 (Matrox m3D) for games with a PowerVR version: off or
# pcx2. It draws into the display adapter's VESA frame buffer. Changes
# take effect at the DOS prompt. How it filters textures: auto (as the
# game sets it), point or bilinear.
#powervr=off
#powervr_filter=auto
# Where screenshots (Ctrl+F5) and sound (Ctrl+F6), video (Ctrl+F7) and
# animation (PrintScreen) recordings go: a folder, relative to the
# directory rust-dos started in.
#capture_dir=capture
# Whether screenshots and video and animation recordings show the settings
# window and the performance overlay (Ctrl+Shift+F12) while they are open:
# false (the default, the picture alone) or true.
#record_ui=false
# Whether screenshots and video recordings show the picture through the CRT
# shader, at the size the window shows it: false (the default, the plain
# picture) or true. Animations stay plain. It costs a little time a frame
# while a video records.
#record_shader=false
# RAM in MB, from 2 to as much as the CPU's machines took: 64 on a 386,
# 128 on a 486, 256 on a Pentium, 512 on a Pentium MMX. Memory above the
# first megabyte is extended memory for DOS extenders and XMS.
#memsize=16
# Expanded memory (EMS 4.0), which many games of the early 1990s need: 16 KB
# pages of extended memory, shown through a page frame at E000h, as
# EMM386 has it. true (the default) or false. A change takes effect at the
# DOS prompt.
#ems=true
# Upper memory blocks between 640 KB and 1 MB, D000h to EFFFh (to DFFFh with
# EMS), where LOADHIGH (LH) loads TSRs and drivers out of the way of the
# programs. true (the default) or false. A change takes effect at the DOS
# prompt.
#umb=true
# Pack DOS's tables at the bottom of conventional memory, as DOS=HIGH
# leaves it, so programs get about 617 KB free rather than 576 KB and load
# below 64 KB. false spreads them up to 64 KB, where programs start at
# segment 1000h. true (the default) or false. A change takes effect at the
# DOS prompt.
#dos_high=true
# A DPMI host for DOS extenders (DOS/4GW, PMODE/W, DOS/32A, DJGPP), as a
# memory manager or Windows has one: they run their programs as its
# clients and share extended memory through it. true (the default) or
# false.
#dpmi=true
# The DOS version programs are told, such as 5.00 (the default), 6.22 or
# 7.10. The FAT32 functions of MS-DOS 7 (INT 21h AX=7302h to 7305h), which
# disk utilities use, answer from 7.00 on; FAT32 drives mount at any
# version. A change takes effect at once.
#dos_version=5.00
# A system booted from a disk image (BOOT) finds its hard disks as ATA disks
# on the IDE channels as well as through INT 13h, for its own IDE driver
# (Windows 9x's 32-bit disk access, Linux): true (the default) or false.
#ide_hard_disks=true
# Capture the mouse as it moves over the window while a program uses the
# mouse driver (INT 33h), and let it go as the program's cursor leaves the
# screen, where its cursor is rather than where the host's pointer would
# be. Without it a click, Ctrl+Alt or Ctrl+F10 captures the mouse. true
# (the default) or false.
#mouse_autocapture=true
# Captured mouse motion multiplier: 0.1 to 10.0, default 1.0.
# The settings slider adjusts in steps of 0.1.
#mouse_sensitivity=1.0
# Say over the picture when the mouse is captured or let go: true (the
# default) or false.
#mouse_capture_messages=true
# Rewind: holding Alt+F11 goes back in time, half a second a step. It keeps
# the machine's states of the last minutes, which take memory and a little
# of the host's time: true or false (the default).
#rewind=false
# The memory rewind's states may take, in MB (16 to 4096); the oldest go
# when they need more.
#rewind_memory=256
# Skip the passes of busy-wait loops that change nothing until the next
# timer event (a program waiting for a key, the retrace or the timer), so
# the emulator sleeps instead. Exact: programs see nothing of it.
#idle_skip=true
# Let Windows' idle calls (Windows 3.1's idle loop) wait for the next timer
# event, as HLT does. Saves host CPU on an idle Windows desktop, but isn't
# exact: the idle loop runs fewer passes than it would.
#idle_hint=false
# How fast hard disks are, as DOSBox Staging has it:
#   maximum  as fast as possible, no slowdown (the default)
#   fast     a mid-1990s hard disk (~15 MB/s)
#   medium   an early 1990s hard disk (~2.5 MB/s)
#   slow     a 1980s hard disk (~600 kB/s)
#hard_disk_speed=maximum
# How fast floppy drives are:
#   maximum  as fast as possible, no slowdown (the default)
#   fast     an extra-high density (ED) floppy (~120 kB/s)
#   medium   a high density (HD) floppy (~60 kB/s)
#   slow     a double density (DD) floppy (~30 kB/s)
#floppy_disk_speed=maximum

[sound]
# The Sound Blaster: sb16 (the default), awe32 (an SB16 with the EMU8000
# wavetable synthesizer), sbpro2, sb2, or none. Programs learn its settings
# from the BLASTER environment variable, which follows these.
#sbtype=sb16
# Base port (hex), IRQ, 8-bit DMA channel, and the SB16's 16-bit channel.
#sbbase=220
#irq=7
#dma=1
#hdma=5
# The AWE32's 1 MB sample ROM with its General MIDI instruments, which
# doesn't come with rust-dos. Without it rust-dos looks for awe32.raw
# beside this file's default location and in the working directory; the
# settings window can download it. The card works without it, but the
# ROM's instruments are silent.
#awe32rom=~/roms/awe32.raw
# The AWE32's sample RAM in KB: 512 (the default), 0, 1024, 2048, 4096,
# 8192, 12288, 16384 or 28672.
#awe32ram=512
# FM synthesizer: opl3 (as on an SB Pro 2 or SB16) or opl2 (AdLib, SB 2.0).
#opl=opl3
# A General MIDI SoundFont (.sf2) for music sent to the MPU-401 at 330h.
#soundfont=~/soundfonts/GeneralUser.sf2
# The Gravis Ultrasound: true (the default) or false. Programs learn its
# settings from the ULTRASND and ULTRADIR environment variables, which
# follow these.
#gus=true
# Base port (hex: 210, 220, 240, 250 or 260), IRQ and DMA channel.
#gusbase=240
#gusirq=5
#gusdma=3
# The drive (D to Y) with the Gravis MIDI patches built into rust-dos, in
# \ULTRASND, read-only. It is there when the Ultrasound is. none leaves it
# out, to use patches of your own in ultradir.
#gusdrive=X
# The DOS directory with the Ultrasound software and its MIDI patches.
# The default is \ULTRASND on gusdrive, or C:\ULTRASND with gusdrive=none.
#ultradir=X:\ULTRASND
# What plays the MIDI sent to the MPU-401: auto (the SoundFont if one is
# set, else the Ultrasound patches in ultradir), soundfont, gus, mt32 (a
# Roland MT-32 or CM-32L, played by munt), sc55 (a Roland Sound Canvas,
# built in), host (out of a MIDI port of this computer, to a synthesizer
# there or a real module), or none.
#midisynth=auto
# The MT-32's ROMs for midisynth=mt32: a directory with a control ROM and a
# PCM ROM of the same model, whatever the files are called. Without it
# rust-dos looks in mt32-roms beside this file's default location, in
# DOSBox's mt32-roms and in /usr/share/mt32-rom-data. munt's library
# (libmt32emu) must be installed; mt32lib gives its path if the system
# doesn't find it.
#mt32roms=~/mt32-roms
# Which ROMs to play with: auto (the CM-32L's if they are there, else the
# MT-32's), mt32 or cm32l.
#mt32model=auto
#mt32lib=/usr/lib/libmt32emu.so.2
# The Sound Canvas's ROMs for midisynth=sc55: a directory with them (in
# subfolders or zip archives too), whatever the files are called. Without
# it rust-dos looks in sc55-roms beside this file's default location and
# in DOSBox Staging's soundcanvas-roms. The settings window can download
# them; they are Roland's and don't come with rust-dos.
#sc55roms=~/sc55-roms
# Which Sound Canvas: auto (the SC-55 v1.21 if there, else the SC-55mkII,
# else any found), a model (mk1, mk2, st, sc155, sc155mk2, cm300, scb55,
# rlp3237) or a version (mk1-v1.21, mk2-v1.01, ...).
#sc55model=auto
# The MIDI port for midisynth=host: a part of its name or its number. The
# default is the first port (on Linux, the first other than Midi Through).
#midiport=FLUID
# A DAC on the parallel port LPT1 (378h), which many games play digital
# sound through: none (the default), disney (the Disney Sound Source) or
# covox (the Covox Speech Thing).
#lpt_dac=none
# The Tandy 1000's and PCjr's sound chip at port C0h, three square waves
# and noise: auto (the default) on those machines (machine), on on any, for
# games that play Tandy sound with VGA graphics, or off.
#tandy=auto
# The noises the hard disks and floppy drives make: off (the default),
# seek-only (the heads moving), or on (the disk spinning as well). They
# sound best with the disk speeds above set lower than maximum.
#hard_disk_noise=off
#floppy_disk_noise=off

[mixer]
# The volume of each sound source in percent, 0 to 200. At 100, the
# default, a source plays as loud as its card makes it; master is the
# volume of them all. Programs set the Sound Blaster's own mixer on top.
#master=100
# The PC speaker and the beeps of the DOS prompt.
#speaker=100
# The Sound Blaster's digital audio, and its FM synthesizer (the AdLib).
#sb=100
#fm=100
# The Gravis Ultrasound.
#gus=100
# General MIDI music sent to the MPU-401.
#midi=100
# The audio tracks of CDs, and the disk drives' noises.
#cdaudio=100
#disknoise=100
# The Covox or Disney Sound Source on the parallel port (lpt_dac).
#lptdac=100
# The Tandy's and PCjr's sound chip.
#tandy=100
# The AWE32's wavetable synthesizer.
#awe32=100
# The PC speaker through a filter that gives it the sound of the small
# speaker in a PC, without the harsh edges: on (the default) or off.
#speaker_filter=on
# The Sound Blaster's output filter: auto (the default) filters as the
# model does (sbtype: 4.8 kHz on an SB 2.0, 3.2 kHz on an SB Pro, half the
# sample rate on an SB16), off leaves the sound as the card makes it.
#sb_filter=auto
# A reverb for the FM synthesizer and MIDI music: off (the default), tiny,
# small, medium, large or huge.
#reverb=off
# How the music and the reverb are mixed, in percent: 0 is the music dry,
# without the reverb, 100 the reverb alone, and at 50 (the default) both
# play in full. Below 50 the reverb fades out, above it the dry music.
#reverb_mix=50
# A chorus for the FM synthesizer and MIDI music: off (the default), light,
# normal or strong.
#chorus=off
# How the music and the chorus are mixed, as reverb_mix: 0 dry, 100 the
# chorus alone, 50 (the default) both in full.
#chorus_mix=50
# How much sound waits for the sound device, and so how late it is heard:
# the device's buffer in frames, 128, 256, 512 (the default, about 12 ms),
# 1024 or 2048, and the queue on top of it in milliseconds, 5, 10, 15, 20
# (the default), 25, 30, 40 or 50. Smaller is sooner; if the sound
# crackles, make them larger.
#blocksize=512
#prebuffer=20

[joystick]
# What the game port has plugged in: auto (the default: one game controller
# is both joysticks and all four buttons, two are a joystick each, and
# without any nothing is plugged in), 4axis (one controller: the left
# stick is joystick A, the right stick joystick B, A, B, X and Y the four
# buttons), 2axis (two controllers, each a joystick with two buttons),
# mouse, or none (no game port).
#joysticktype=auto
# How far a stick moves before it counts, in percent of its travel (0 to
# 90), so a controller at rest reads as centred.
#deadzone=10

[network]
# The IPX driver of the built-in DOS, for games that play over a network:
# auto (the default: from the first LAN HOST or LAN JOIN on), true or
# false.
#ipx=auto
# Its IRQ: auto (the first of 11, 15, 10 and 9 no sound card has), or 3,
# 4, 5, 7, 9, 10, 11 or 15.
#ipxirq=auto
# How its packets go into Ethernet frames: ethernet_ii (the default),
# 802.3, 802.2 or snap. A booted Windows 95 on another instance should use
# the same frame type for its IPX/SPX protocol.
#ipxframe=ethernet_ii
# An NE2000 network card, for packet drivers (Crynwr NE2000.COM),
# Windows for Workgroups and Windows 95: true or false (the default). It
# is on the LAN rust-dos instances join with LAN HOST and LAN JOIN.
#ne2000=false
# Its ports (240, 260, 280, 2A0, 2C0, 300, 320, 340 or 360; 300 is the
# usual one), its IRQ (3, 4, 5, 7, 9, 10, 11 or 15), and its Ethernet
# address: auto (a new one each start) or one like 02:00:5E:12:34:56.
#nicbase=300
#nicirq=10
#macaddr=auto
# Where the rooms of LAN JOIN and LAN LIST without an address, and of the
# settings window's room browser, are: false (the default) on this
# network, where a room made in the browser is hosted in this instance,
# or true online, at the relay (a host[:port]). relay.rust-dos.com is a
# public relay, where anyone can find and make rooms.
#online=false
#relay=relay.rust-dos.com
# The name the others in a LAN room see your player by. Without one they
# see "Player" and a number.
#player=
# A LAN room to join at startup, as LAN JOIN does: off, discover (the
# first relay that answers on this network) or a relay's host[:port].
#lan=off
# Relay LAN rooms for other instances from startup, on this UDP port (and
# join one), as LAN HOST does: off or a port (21213 is the usual one).
#lanhost=off
# The room to join, and its password: the one joining gives a room that
# isn't there yet its password, and a relay with a password of its own
# wants that one.
#room=lobby
#password=

[serial]
# What the serial ports have plugged in: off, mouse (a serial mouse moved
# by the host's mouse), modem (a Hayes modem: any number calls the other
# player in the LAN room, a host[:port] a host over TCP, and it works as a
# null modem cable to the other player too), nullmodem (a cable to the
# other player in the LAN room) or empty (the port alone). The first two
# players in a LAN room are linked through the first modem or nullmodem.
#serial1=mouse
#serial2=modem
#serial3=off
#serial4=off
# Their IRQs (COM3 shares COM1's and COM4 COM2's, as on a PC).
#serial1irq=4
#serial2irq=3
#serial3irq=4
#serial4irq=3
# The chip: 16550 (with FIFOs) or 8250.
#uart=16550
# The serial mouse: microsoft (two buttons) or logitech (three).
#mousetype=microsoft
# Take calls for the modem on this TCP port: off or a port. A call rings
# the modem (ATA answers).
#modemlisten=off
# Speak telnet on the modem's TCP calls, for BBSes: off or on.
#modemtelnet=off

[printer]
# A printer on the parallel port LPT1 (378h), an Epson ESC/P 2 printer as
# DOSBox-X has one, which programs print to through the port, the BIOS
# (INT 17h) or DOS (PRN, LPT1). What it prints goes to: pdf (the default,
# a PDF document of each print job), png (a PNG picture of each page),
# printer (the host's printer: lp, or on Windows the program that prints
# PDF files), file (the bytes as sent, in a .prn file, for a printer
# driver of the host's to take) or none (no printer, and no LPT1). A DAC
# on LPT1 (lpt_dac) takes the port's place.
#output=pdf
# The pages' resolution in dots per inch (60 to 720), and the paper:
# letter, a4, legal or <width>x<height> in inches.
#dpi=360
#paper=letter
# Whether a job's pages go into one PDF document (true), or each into its
# own (false).
#multipage=true
# A print job ends, and the page in the printer comes out, after this many
# milliseconds without printing, or 0 for only when Ctrl+Shift+F5 ejects
# the page.
#timeout=3000
# Where the files go (the capture folder, capture_dir, if not set).
#docpath=
# The printer's fonts, as DOSBox-X names them (roman.ttf, sansserif.ttf,
# courier.ttf, script.ttf, ocra.ttf). Without them, the host's (Liberation,
# DejaVu, the Windows and macOS ones) print, or else the VGA's ROM font.
#fontpath=
# The host printer (lp -d), if not the default one.
#device=
# A program that prints the finished PDF in place of lp, with {file} for
# the file (after the command if it has none): lpr -P office {file}.
#print_command=
# A program to open each file written with: xdg-open, or a viewer.
#open_with=

[achievements]
# RetroAchievements (retroachievements.org): achievements, leaderboards and
# rich presence for games launched from their profiles, which say which
# version of the game they are (achievements= in [game]; a zip dropped on
# the window gets it). Log in on the settings window's Achievements page,
# which keeps the site's token here, not the password.
#enabled=true
# Hardcore mode, from the next game on: no save states, rewind or cheats,
# and unlocks and leaderboard entries count as hardcore.
#hardcore=false
#username=
#token=

[shell]
# The DOS prompt, after clink. Suggest the rest of the line from the
# history (Right or End takes it).
#autosuggest=true
# Color the prompt and the line typed at it.
#colors=true
# Keep the lines typed in shell_history.txt beside this file's default
# location, and how many.
#save_history=true
#history_size=1000
# The colors: black, blue, green, cyan, red, magenta, brown, lightgray,
# darkgray, lightblue, lightgreen, lightcyan, lightred, lightmagenta,
# yellow, white, or default (the screen's).
#prompt_color=lightgray
#command_color=white
#executable_color=lightcyan
#unrecognized_color=lightred
#argument_color=default
#flag_color=yellow
#suggestion_color=darkgray

[vr]
# The picture on a screen in a 3D scene. off, headset (a VR headset
# through OpenXR, such as SteamVR or Monado; --vr) or desktop (the scene in
# the window, with a camera moved with the mouse while Ctrl+Shift is held;
# --vr-desktop).
#mode=off
# The scene: a glTF file (.glb or .gltf) exported from Blender, with the
# mesh the picture goes on named "screen". Empty for the built-in room.
#scene=
# What a headset's controllers do: both (the hand pointing at the screen
# is the mouse, trigger and grip its buttons; the sticks and other buttons
# a gamepad), pointer or gamepad.
#controllers=both
# The sound comes from the screen's sides (or the scene's speaker_left and
# speaker_right) as you turn and move.
#spatial_audio=true
# How much of the scene's lighting is worked out: high (soft shadows, the
# screen's light in patches of the picture's colours, light bouncing around
# the room, darker corners and gaps), medium, or low (hard shadows, no
# bounced light, no darkened corners).
#quality=high
# How brightly the screen lights the room, in percent of what the scene
# says (0 to 400).
#screen_glow=100
# Fine-tuning where you sit in a headset. How big the scene looks, in
# percent (50 to 200; above 100 it is bigger and you smaller).
#scene_scale=100
# Where the seat is from the scene's spawn, in cm (-100 to 100): to the
# right, up and closer to the screen; and how far it is turned to the left,
# in degrees (-180 to 180).
#seat_right=0
#seat_up=0
#seat_forward=0
#seat_turn=0

[drives]
# Mount host directories, or floppy, hard disk or CD images, as DOS drives
# A: to Y:
#   <letter> = <host path> [more images] [floppy|hdd|cdrom] [-label NAME]
#              [-ro] [-chs C,H,S] [-boot]
#
# hdd is the default type. floppy drives are removable 1.44 MB disks, cdrom
# drives are read-only and visible to programs through MSCDEX, and -ro makes
# any drive read-only. -label sets the volume label (up to 11 characters).
# A: and B: are always floppy drives.
# Disk images (.img, .ima, .vfd, .flp, .dsk, 86Box's .86f) hold a FAT12
# or FAT16 file system that programs can read and write, also sector by
# sector through the BIOS (INT 13h) and DOS (INT 25h/26h). An image the size of a floppy
# disk is a floppy, others are hard disks with a partition table; -chs
# gives a hard disk image's geometry where it can't be found from the
# image. CD images are .cue, .iso and .bin files.
# A list of images puts the first in the drive; Ctrl+F4 changes to the
# next, in every drive with a list.
# -boot boots a disk image (Windows 95, MS-DOS, ...) when Rust-DOS starts,
# after [autoexec] and instead of C:\AUTOEXEC.BAT; --no-boot skips it.
# Quote paths that contain spaces. ~ is your home directory and relative
# paths are relative to this file.
# C: is the current working directory unless set here or with -d/--dir.
#C=~/dos
#A=~/dos/floppy floppy -label DISK1
#B=~/dos/images/disk1.img ~/dos/images/disk2.img
#F=~/dos/images/win95.img -boot
#D="~/dos/My CD" cdrom -label GAMECD
#E=~/dos/images/game.cue

[autoexec]
# Commands typed at the DOS prompt on startup, one per line. They run
# before C:\AUTOEXEC.BAT. A program started here delays the lines after it
# until it exits.
#MOUNT E ~/dos/extra
#C:
#CD GAMES
