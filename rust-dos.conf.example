# rust-dos configuration file
#
# rust-dos uses the first configuration file it finds (files are never
# merged):
#   1. the file given with -c/--config
#   2. rust-dos.conf in the current working directory
#   3. rust-dos.conf in the per-user configuration directory:
#        Linux:   ~/.config/rust-dos/  (or $XDG_CONFIG_HOME/rust-dos/)
#        macOS:   ~/Library/Application Support/rust-dos/
#        Windows: %APPDATA%\rust-dos\
# If none exists, a copy of this template is written to (3).
# Start with --no-config to ignore all configuration files.
#
# Lines starting with # or ; are comments. Remove the # to use a setting.

[emulator]
# Window scale factor. -s/--scale overrides it.
#scale=2
# Fill the screen instead of a window, keeping the picture's proportions.
#fullscreen=false
# Stretch the picture to 4:3, as a monitor showed 320x200 and 640x400.
#aspect=false
# How the picture is scaled up: nearest (sharp pixels) or linear (smooth).
# Only without a CRT shader, which does its own scaling.
#filter=nearest
# A CRT look for the picture:
#   none       the pixels as they are (the default)
#   scanlines  a flat screen with the scanlines of a VGA monitor
#   aperture   a flat aperture grille monitor: scanlines and phosphor stripes
#   crt        a curved tube with a shadow mask, rounded corners and glow
# The looks need OpenGL 3 and show best at scale 2 or more, or fullscreen.
# Screenshots and recordings stay without them.
#shader=none
# How far the crt look's tube bends, in percent: 0 is flat, 100 the most.
#crt_curvature=30
# A monochrome monitor: off (colour, the default), white, amber or green.
# The picture shows in the phosphor's colour, as bright as its colours
# are, and the CRT shaders leave out their colour mask. On a VGA or EGA
# (machine), programs see the monochrome monitor too, from the DOS prompt
# on, and the prompt is the monochrome text mode 7.
#monochrome=off
# The CGA's composite monitor (machine=cga): the colours a composite
# monitor or TV makes of fine patterns of pixels, which King's Quest, the
# Ultima games and many more drew their graphics with. auto (the default)
# decodes the picture as a composite monitor does when a program turns on
# 640x200 graphics with the colour burst, which only programs for
# composite monitors do; on always does in the graphics modes; off shows
# the RGB monitor's colours.
#composite=auto
# The CGA that makes the composite signal: old (IBM's first cards, which
# the classic games were drawn for) or new (from 1984 on).
#composite_era=old
# CPU speed in instructions per millisecond, or max to run as fast as the
# host keeps up with in real time. Lower it for old games that run too
# fast. --cycles overrides it.
#cycles=max
# Processor: 486 (the default, a 486DX with FPU) or 386.
#cpu=486
# What runs the programs' instructions:
#   auto     the interpreter, and the dynamic recompiler for a program
#            from when it switches to protected mode until it ends (the
#            default, as in DOSBox)
#   dynamic  the dynamic recompiler, which translates the programs' code
#            into the host's and runs protected-mode games several times
#            faster
#   normal   the interpreter
# Both run programs exactly the same way. The recompiler needs an x86-64
# or ARM64 host; on others the interpreter runs everything. --core
# overrides it.
#core=auto
# The display adapter, which programs look for to pick their graphics:
#   svga  a VGA with VESA modes up to 1024x768 (the default)
#   vga   an IBM VGA, without VESA modes
#   ega   an IBM EGA with an Enhanced Color Display: 16 of 64 colours
#   cga   an IBM CGA: 4 colours at 320x200, 2 at 640x200
#   tandy a Tandy 1000: the CGA's modes and 16 colours at 160x200 and
#         320x200, 4 at 640x200, and its three-voice sound chip
#   pcjr  an IBM PCjr, which the Tandy copies
#   hercules  a Hercules Graphics Card on a monochrome monitor: text and
#         720x348 graphics
# A change takes effect at the DOS prompt.
#machine=svga
# Where screenshots (Ctrl+F5) and sound (Ctrl+F6), video (Ctrl+F7) and
# animation (PrintScreen) recordings go: a folder, relative to the
# directory rust-dos started in.
#capture_dir=capture
# RAM in MB, 2 to 64. Memory above the first megabyte is extended memory
# for DOS extenders and XMS.
#memsize=16
# Expanded memory (EMS 4.0), which many games of the early 1990s need: 16 KB
# pages of extended memory, shown through a page frame at E000h, as
# EMM386 has it. true (the default) or false. A change takes effect at the
# DOS prompt.
#ems=true
# Upper memory blocks between 640 KB and 1 MB, D000h to EFFFh (to DFFFh with
# EMS), where LOADHIGH (LH) loads TSRs and drivers out of the way of the
# programs. true (the default) or false. A change takes effect at the DOS
# prompt.
#umb=true
# How fast hard disks are, as DOSBox Staging has it:
#   maximum  as fast as possible, no slowdown (the default)
#   fast     a mid-1990s hard disk (~15 MB/s)
#   medium   an early 1990s hard disk (~2.5 MB/s)
#   slow     a 1980s hard disk (~600 kB/s)
#hard_disk_speed=maximum
# How fast floppy drives are:
#   maximum  as fast as possible, no slowdown (the default)
#   fast     an extra-high density (ED) floppy (~120 kB/s)
#   medium   a high density (HD) floppy (~60 kB/s)
#   slow     a double density (DD) floppy (~30 kB/s)
#floppy_disk_speed=maximum

[sound]
# The Sound Blaster: sb16 (the default), sbpro2, sb2, or none. Programs
# learn its settings from the BLASTER environment variable, which follows
# these.
#sbtype=sb16
# Base port (hex), IRQ, 8-bit DMA channel, and the SB16's 16-bit channel.
#sbbase=220
#irq=7
#dma=1
#hdma=5
# FM synthesizer: opl3 (as on an SB Pro 2 or SB16) or opl2 (AdLib, SB 2.0).
#opl=opl3
# A General MIDI SoundFont (.sf2) for music sent to the MPU-401 at 330h.
#soundfont=~/soundfonts/GeneralUser.sf2
# The Gravis Ultrasound: true (the default) or false. Programs learn its
# settings from the ULTRASND and ULTRADIR environment variables, which
# follow these.
#gus=true
# Base port (hex: 210, 220, 240, 250 or 260), IRQ and DMA channel.
#gusbase=240
#gusirq=5
#gusdma=3
# The drive (D to Y) with the Gravis MIDI patches built into rust-dos, in
# \ULTRASND, read-only. It is there when the Ultrasound is. none leaves it
# out, to use patches of your own in ultradir.
#gusdrive=X
# The DOS directory with the Ultrasound software and its MIDI patches.
# The default is \ULTRASND on gusdrive, or C:\ULTRASND with gusdrive=none.
#ultradir=X:\ULTRASND
# What plays the MIDI sent to the MPU-401: auto (the SoundFont if one is
# set, else the Ultrasound patches in ultradir), soundfont, gus, mt32 (a
# Roland MT-32 or CM-32L, played by munt), host (out of a MIDI port of
# this computer, to a synthesizer there or a real module), or none.
#midisynth=auto
# The MT-32's ROMs for midisynth=mt32: a directory with a control ROM and a
# PCM ROM of the same model, whatever the files are called. Without it
# rust-dos looks in mt32-roms beside this file's default location, in
# DOSBox's mt32-roms and in /usr/share/mt32-rom-data. munt's library
# (libmt32emu) must be installed; mt32lib gives its path if the system
# doesn't find it.
#mt32roms=~/mt32-roms
# Which ROMs to play with: auto (the CM-32L's if they are there, else the
# MT-32's), mt32 or cm32l.
#mt32model=auto
#mt32lib=/usr/lib/libmt32emu.so.2
# The MIDI port for midisynth=host: a part of its name or its number. The
# default is the first port (on Linux, the first other than Midi Through).
#midiport=FLUID
# A DAC on the parallel port LPT1 (378h), which many games play digital
# sound through: none (the default), disney (the Disney Sound Source) or
# covox (the Covox Speech Thing).
#lpt_dac=none
# The Tandy 1000's and PCjr's sound chip at port C0h, three square waves
# and noise: auto (the default) on those machines (machine), on on any, for
# games that play Tandy sound with VGA graphics, or off.
#tandy=auto
# The noises the hard disks and floppy drives make: off (the default),
# seek-only (the heads moving), or on (the disk spinning as well). They
# sound best with the disk speeds above set lower than maximum.
#hard_disk_noise=off
#floppy_disk_noise=off

[mixer]
# The volume of each sound source in percent, 0 to 200. At 100, the
# default, a source plays as loud as its card makes it; master is the
# volume of them all. Programs set the Sound Blaster's own mixer on top.
#master=100
# The PC speaker and the beeps of the DOS prompt.
#speaker=100
# The Sound Blaster's digital audio, and its FM synthesizer (the AdLib).
#sb=100
#fm=100
# The Gravis Ultrasound.
#gus=100
# General MIDI music sent to the MPU-401.
#midi=100
# The audio tracks of CDs, and the disk drives' noises.
#cdaudio=100
#disknoise=100
# The Covox or Disney Sound Source on the parallel port (lpt_dac).
#lptdac=100
# The Tandy's and PCjr's sound chip.
#tandy=100
# The PC speaker through a filter that gives it the sound of the small
# speaker in a PC, without the harsh edges: on (the default) or off.
#speaker_filter=on
# The Sound Blaster's output filter: auto (the default) filters as the
# model does (sbtype: 4.8 kHz on an SB 2.0, 3.2 kHz on an SB Pro, half the
# sample rate on an SB16), off leaves the sound as the card makes it.
#sb_filter=auto
# A reverb for the FM synthesizer and MIDI music: off (the default), tiny,
# small, medium, large or huge.
#reverb=off
# How the music and the reverb are mixed, in percent: 0 is the music dry,
# without the reverb, 100 the reverb alone, and at 50 (the default) both
# play in full. Below 50 the reverb fades out, above it the dry music.
#reverb_mix=50
# A chorus for the FM synthesizer and MIDI music: off (the default), light,
# normal or strong.
#chorus=off
# How the music and the chorus are mixed, as reverb_mix: 0 dry, 100 the
# chorus alone, 50 (the default) both in full.
#chorus_mix=50

[joystick]
# What the game port has plugged in: auto (the default: one game controller
# is both joysticks and all four buttons, two are a joystick each, and
# without any the mouse is joystick A), 4axis (one controller: the left
# stick is joystick A, the right stick joystick B, A, B, X and Y the four
# buttons), 2axis (two controllers, each a joystick with two buttons),
# mouse, or none (no game port).
#joysticktype=auto
# How far a stick moves before it counts, in percent of its travel (0 to
# 90), so a controller at rest reads as centred.
#deadzone=10

[drives]
# Mount host directories, or floppy, hard disk or CD images, as DOS drives
# A: to Y:
#   <letter> = <host path> [more images] [floppy|hdd|cdrom] [-label NAME]
#              [-ro] [-chs C,H,S]
#
# hdd is the default type. floppy drives are removable 1.44 MB disks, cdrom
# drives are read-only and visible to programs through MSCDEX, and -ro makes
# any drive read-only. -label sets the volume label (up to 11 characters).
# A: and B: are always floppy drives.
# Disk images (.img, .ima, .vfd, .flp, .dsk) hold a FAT12 or FAT16 file
# system that programs can read and write, also sector by sector through
# the BIOS (INT 13h) and DOS (INT 25h/26h). An image the size of a floppy
# disk is a floppy, others are hard disks with a partition table; -chs
# gives a hard disk image's geometry where it can't be found from the
# image. CD images are .cue, .iso and .bin files.
# A list of images puts the first in the drive; Ctrl+F4 changes to the
# next, in every drive with a list.
# Quote paths that contain spaces. ~ is your home directory and relative
# paths are relative to this file.
# C: is the current working directory unless set here or with -d/--dir.
#C=~/dos
#A=~/dos/floppy floppy -label DISK1
#B=~/dos/images/disk1.img ~/dos/images/disk2.img
#D="~/dos/My CD" cdrom -label GAMECD
#E=~/dos/images/game.cue

[autoexec]
# Commands typed at the DOS prompt on startup, one per line. They run
# before C:\AUTOEXEC.BAT. A program started here delays the lines after it
# until it exits.
#MOUNT E ~/dos/extra
#C:
#CD GAMES
